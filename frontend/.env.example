# Adres osiągalny z serwera frontendu. Bez końcowego / i bez /api.
BACKEND_URL=http://192.168.1.20:3001
FRONTEND_PORT=5173
CACHE_ADMIN_TOKEN=wstaw-wlasny-dlugi-token
# Hasło okna API. Puste lub nieustawione = CACHE_ADMIN_TOKEN.
# API_SETTINGS_PASSWORD=wlasne-haslo-ustawien
APP_TIMEZONE=Europe/Warsaw
CACHE_REFRESH_SECONDS=60
CACHE_TIMEOUT_SECONDS=5
# Sale odświeżane także bez otwartej strony; puste = TABLET_ROOM_ID i poznane sale.
# CACHE_ROOM_IDS=205,30

# Domyślna sala dla /. Numer w /room/... ma pierwszeństwo.
TABLET_ROOM_ID=205
