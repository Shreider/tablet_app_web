# Tryb lokalny (oba serwery na jednym komputerze).
# Na osobnych serwerach używaj frontend/.env.example i backend/.env.example.
BACKEND_URL=http://backend:3001
FRONTEND_PORT=5173
BACKEND_PORT=3001
ADMIN_TOKEN=change-me-admin-token
APP_TIMEZONE=Europe/Warsaw
CORS_ORIGIN=http://localhost:5173
# Domyślna sala dla adresu /. Numer w /room/... ma pierwszeństwo.
TABLET_ROOM_ID=205

# Lokalna kopia JSON przy frontendzie. Domyślnie używa ADMIN_TOKEN.
# CACHE_ADMIN_TOKEN=wlasny-token-kopii
# Hasło okna API. Puste lub nieustawione = token kopii CACHE_ADMIN_TOKEN (dalej ADMIN_TOKEN).
# API_SETTINGS_PASSWORD=wlasne-haslo-ustawien
CACHE_REFRESH_SECONDS=60
CACHE_TIMEOUT_SECONDS=5
# CACHE_ROOM_IDS=205,30

# Opcjonalnie: istniejący wolumen bazy zamiast domyślnego tablet_app_web_postgres-data.
# POSTGRES_VOLUME=tablet_app_web_postgres-data
# POSTGRES_VOLUME_EXTERNAL=true
